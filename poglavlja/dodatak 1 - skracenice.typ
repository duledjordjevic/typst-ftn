// Овде пишете скраћенице које сте користили у тексту
 
#import "../funkcije.typ": dodatak

// Због аутоматског бројања сваки додатак мора имати лабелу са префиксом
// dodatak- као у наслову испод.
= Списак коришћених скраћеница <dodatak-1>

#dodatak(
    table(
        table.header[*Скраћеница*][*Опис*],

        [API], [Application Programming Interface (апликациони програмски интерфејс)],
        [AWS], [Amazon Web Services (Амазон веб сервиси)],
        [CDK], [Cloud Development Kit (комплет алата за развој у облаку)],
        [CI/CD], [Continuous Integration / Continuous Delivery
            (континуирана интеграција / континуирана испорука)],
        [CLI], [Command Line Interface (интерфејс командне линије)],
        [CRUD], [Create, Read, Update, Delete (креирање, читање, ажурирарање, брисање)],
        [HTTP], [HyperText Transfer Protocol (протокол за пренос хипертекста)],
        [IaaS], [Infrastructure as a Service (инфраструктура као сервис)],
        [JSON], [JavaScript Object Notation(формат за размену података)],
        [JWT], [JSON Web Token (сигурносни токен заснован на JSON формату)],
        [PaaS], [Platform as a Service (платформа као сервис)],
        [QA], [Quality Assurance (обезбеђење квалитета)],
        [REST], [Representational State Transfer (скуп правила за комуникацију
            између клијента и сервера)],
        [S3], [Simple Storage Service (сервис за складиштење података)],
        [SaaS], [Software as a Service (софтвер као сервис)],
        [SNS], [Simple Notification Service (сервис за обавештавање)],
        [SQS], [Simple Queue Service (сервис за обавештавање уз помоћ редова)],
        [URL], [Uniform Resource Locator (јединствени идентификатор и локатор ресурса)],
    ),
)
