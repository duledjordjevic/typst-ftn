// Овде пишете објашњење најважнијих појмова које сте користили у тексту
 
#import "../funkcije.typ": dodatak

// Због аутоматског бројања сваки додатак мора имати лабелу са префиксом
// dodatak- као у наслову испод.
= Списак коришћених појмова <dodatak-2>

#dodatak(
    table(
        [*Појам*], [*Објашњење*],
        [Артефакт], [Излазни производ процеса изградње софтвера, као што су 
            извршне датотеке, библиотеке или пакети.],

        [Асихнрони рад], [Рад који се изводи независно од главног тока извршавања,
            омогућавајући наставак других операција без чекања на његов завршетак.],

        [Bucket (S3)], [Логичка јединица за складиштење у AWS S3 сервису,
            која организује фајлове у облаку.],

        [Blue-green deployment], [Стратегија постављања где се нова верзија апликације 
            поставља паралелно са постојећом, са тренутном променом саобраћаја.],

        [Canary release], [Стратегија постепеног постављања где се нова верзија 
            апликације прво испоручује малом проценту корисника пре потпуног постављања.],

        [CloudFormation], [AWS сервис за дефинисање и управљање инфраструктуром 
            помоћу шаблона.],

        [Code smell], [Индикатор потенцијалног проблема у коду који указује на лош 
            дизајн или погрешну имплементацију.],
        
        [Догађајно оријентисана архитектура], [Архитектурни приступ где компоненте 
            система реагују на догађаје, омогућавајући лабаво повезивање.],
        
        [Lambda функција], [Безсервска функција која се извршава као одговор на 
            догађаје без потребе за управљањем серверима.],
        
        [Микросервис], [Архитектурни приступ где апликација се гради као скуп малих, 
            независних сервиса.],
        
        [Pipeline], [Низ аутоматизованих корака за изградњу, тестирање и постављање 
            софтвера.],
        
        [Presigned URL], [Привремени URL који омогућава ограничен приступ ресурсима 
            без потребе за аутентификацијом.],
        
        [Rollback], [Процес враћања система на претходну стабилну верзију након 
            откривања проблема.],
        
        [Serverless], [Модел извршавања где cloud провајдер управља инфраструктуром, 
            а корисник плаћа само за стварно коришћене ресурсе.],
        
        [Stack], [Логичка целина AWS ресурса којом се управља као једна јединица.],
        
        [Транскодирање], [Процес конверзије мултимедијалног садржаја из једног формата 
            или резолуције у други.],
        
        [Webhook], [Механизам за аутоматско слање HTTP обавештења када се деси 
            одређени догађај.],
    ),
)
